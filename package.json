{
  "name": "pm2-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Painel web simples para gerenciar processos PM2",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:updtae": "pm2 restart ecosystem.config.js --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pm2": "^6.0.8"
  }
}